# ==============================================================================
# AquaGuard J26-SE-351: Remote ESP32 Sensor Bridge (Aquio Cloud Backend)
# ==============================================================================

# Enable/Disable remote sensor polling (set to true when ready)
AQUIO_ENABLED=false

# Aquio Backend API Base URL (from Swagger: https://api.aquio.smartaquamarket.com/api/v1/docs#/)
AQUIO_API_URL=https://api.aquio.smartaquamarket.com/api/v1

# Credentials for logging into the remote Aquio backend
AQUIO_EMAIL=your_email@example.com
AQUIO_PASSWORD=your_password_here

# The target Tank ID assigned to the ESP32 sensor hub
AQUIO_TANK_ID=1

# Polling frequency in seconds
AQUIO_POLL_INTERVAL_SEC=2.0

# ==============================================================================
# Local System Configuration
# ==============================================================================
EDGE_NODE_URL=http://localhost:3000
BACKEND_PORT=8000
